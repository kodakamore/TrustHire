{
  "name": "trusthire-backend",
  "version": "1.0.0",
  "description": "Backend API for TrustHire platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node db/migrate.js",
    "test": "node tests/crypto.test.js && node tests/redaction.test.js && node tests/core.test.js && node tests/api.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:workflow": "node tests/e2e.workflow.test.js",
    "test:all": "npm test && npm run test:e2e && npm run test:workflow && npm run pii:verify && node scripts/check-fixtures.js",
    "pii:inventory": "node scripts/inventory-pii.js",
    "pii:backfill": "node scripts/backfill-nin-bvn.js",
    "pii:backfill:verify": "node scripts/backfill-nin-bvn.js --verify",
    "pii:photos": "node scripts/extract-photos.js --dry-run",
    "pii:photos:apply": "node scripts/extract-photos.js --apply",
    "pii:photos:verify": "node scripts/extract-photos.js --verify",
    "pii:verify": "node scripts/verify-migration.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "resend": "^6.28.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
