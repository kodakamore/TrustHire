PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trusthire
JWT_SECRET=your-jwt-secret-very-secure
JWT_EXPIRES_IN=7d
DOJAH_APP_ID=your-dojah-app-id
DOJAH_SECRET_KEY=your-dojah-secret-key
DOJAH_BASE_URL=https://sandbox.dojah.io
WHOIS_API_KEY=your-whoisjson-api-key
WHOIS_BASE_URL=https://whoisjson.com/api/v1
WHOISXML_API_KEY=your-whoisxml-api-key
APIVOID_API_KEY=your-apivoid-api-key
MAX_DOMAIN_RISK_SCORE=20
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000
FRONTEND_RECRUITER_URL=http://localhost:3000
FRONTEND_SEEKER_URL=http://localhost:3001
FRONTEND_ADMIN_URL=http://localhost:3002
VERIFICATION_VALIDITY_DAYS=90
MIN_FACE_MATCH_SCORE=85.0
MIN_LIVENESS_SCORE=80.0
MIN_DOMAIN_AGE_DAYS=30
# Secret used to derive each company's DNS TXT ownership-verification token
# (HMAC-based, so no separate token needs to be stored in the DB). Falls
# back to JWT_SECRET if unset — set a distinct value in production.
DNS_VERIFY_SECRET=your-dns-verification-secret

# ===========================================================================
# ENCRYPTION (see docs/ENCRYPTION.md)
# ===========================================================================
# 32-byte master key, base64. NO FALLBACK — server refuses to boot without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back up OFFLINE: losing it makes encrypted NIN/BVN/photos unreadable.
ENCRYPTION_MASTER_KEY=
# 'plaintext' = dual-write, legacy reads (during backfill)
# 'encrypted' = prefer *_enc columns, fallback to plaintext (post-backfill)
READ_MODE=plaintext
# Encrypted photo storage root (outside public/, gitignored)
STORAGE_ROOT=storage/photos
MAX_PHOTO_BYTES=5000000
